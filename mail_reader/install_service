#!/usr/bin/env bash
# Install/refresh the mail_reader user systemd unit. No sudo needed —
# this is a --user unit running as $USER (linger must be enabled).

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UNIT_DIR"

echo "==> installing $UNIT_DIR/mail-reader.service"
install -m 0644 mail-reader.service "$UNIT_DIR/mail-reader.service"

echo "==> systemctl --user daemon-reload"
systemctl --user daemon-reload

if systemctl --user is-active --quiet mail-reader.service; then
	echo "==> restarting mail-reader"
	systemctl --user restart mail-reader.service
else
	echo "==> enabling + starting mail-reader"
	systemctl --user enable --now mail-reader.service
fi

sleep 1
if curl -fsS --max-time 5 http://127.0.0.1:8800/healthz >/dev/null; then
	echo "ok — http://127.0.0.1:8800/healthz responds"
else
	echo "warning: /healthz probe failed — check 'journalctl --user -u mail-reader -e'" >&2
	exit 1
fi
